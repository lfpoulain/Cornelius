{
  "name": "cornelius",
  "version": "0.2.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#cornelius/addons": "./shared/addons.ts",
    "#cornelius/validation": "./shared/validation.ts",
    "#cornelius/testing": "./server/addons/testing.ts"
  },
  "engines": {
    "node": ">=24.2.0 <25"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\" \"addons/*/*.test.ts\"",
    "setup": "tsx scripts/setup.ts",
    "test:e2e": "playwright test",
    "test:modules": "tsx scripts/test-modules.ts",
    "mesures": "tsx scripts/mesures.ts",
    "notices": "tsx scripts/notices.ts",
    "recette": "tsx scripts/recette.ts",
    "format": "prettier --write \"{server,shared,web,tests,addons}/**/*.{ts,tsx,css,html}\" \"scripts/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"{server,shared,web,tests,addons}/**/*.{ts,tsx,css,html}\" \"scripts/*.ts\" \"*.{ts,json}\""
  },
  "dependencies": {
    "@mistralai/mistralai": "3.1.0",
    "@livekit/rtc-node": "0.13.28",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bonjour-service": "1.4.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "5.12.5",
    "lucide-react": "1.46.0",
    "openai": "7.15.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "selfsigned": "5.5.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "packageManager": "npm@11.11.1"
}
