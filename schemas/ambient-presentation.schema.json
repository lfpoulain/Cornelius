{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cornelius AmbientPresentation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout", "title", "value", "subtitle", "items"],
  "properties": {
    "showCollectedAt": { "type": "boolean" },
    "refreshAt": {
      "description": "Instant où la présentation doit être recalculée, sans nouvelle collecte.",
      "type": "string",
      "format": "date-time"
    },
    "layout": {
      "enum": ["metric", "list"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "icon": {
      "description": "Icône facultative de la valeur (liste cardIcons du contrat).",
      "enum": ["cloud", "cloud-drizzle", "cloud-fog", "cloud-hail", "cloud-lightning", "cloud-moon", "cloud-moon-rain", "cloud-rain", "cloud-snow", "cloud-sun", "cloud-sun-rain", "droplets", "haze", "moon", "snowflake", "sun", "sunrise", "sunset", "thermometer", "thermometer-snowflake", "thermometer-sun", "tornado", "triangle-alert", "umbrella", "wind"]
    },
    "value": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120
    },
    "subtitle": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120
    },
    "items": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "icon": { "$ref": "#/properties/icon" }
        }
      }
    }
  }
}
